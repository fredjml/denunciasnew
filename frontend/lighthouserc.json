{
  "ci": {
    "collect": {
      "startServerCommand": "npm run build && npx --yes http-server dist/frontend/browser -p 4200 -c-1 -a 127.0.0.1",
      "startServerReadyPattern": "Available on:",
      "startServerReadyTimeout": 60000,
      "url": ["http://127.0.0.1:4200/"],
      "numberOfRuns": 1,
      "settings": {
        "preset": "perf",
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 400,
          "throughputKbps": 400,
          "cpuSlowdownMultiplier": 4,
          "requestLatencyMs": 400,
          "downloadThroughputKbps": 400,
          "uploadThroughputKbps": 400
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.7 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 4000 }],
        "interactive": ["warn", { "maxNumericValue": 6000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-results"
    }
  }
}
