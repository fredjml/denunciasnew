flowchart LR
    accTitle: Casos de uso do denunciasnew — as-built (2026-09-05)
    accDescr: Atores reais e casos de uso realmente implementados no MVP; nenhum caso de uso de chatbot, classificador real ou BFF de anonimização aparece aqui, por estarem fora do MVP.

    cidadao(["«actor · primário»<br/>Cidadã/cidadão"])
    agentePublico(["«actor · primário»<br/>Agente de órgão público"])
    mock(["«actor · sistema»<br/>backend-mock"])
    mptExterno(["«actor · sistema externo»<br/>Sites do MPT (nova aba)"])

    subgraph sistema["📋 denunciasnew — MVP"]
        direction TB
        acessarPortal(("Acessar Portal<br/>(Acesso Rápido)"))
        acessarServicoExterno(("Abrir serviço externo<br/>do MPT em nova aba"))
        escolherCaminho(("Escolher caminho<br/>no Acolhimento"))
        contarPorTexto(("Contar ocorrência<br/>por texto"))
        contarPorAudio(("Contar ocorrência<br/>por áudio (mock STT)"))
        selecionarIrregularidade(("Selecionar tipo(s)<br/>de irregularidade"))
        detalharOcorrencia(("Detalhar período,<br/>modalidade, nº afetados"))
