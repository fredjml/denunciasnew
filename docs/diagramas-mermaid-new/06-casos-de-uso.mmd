        instalarPwa(("Instalar como app<br/>(PWA)"))
    end

    cidadao --> acessarPortal
    agentePublico --> acessarPortal
    acessarPortal -->|"«extend»"| acessarServicoExterno
    acessarPortal --> escolherCaminho
    escolherCaminho -->|"«extend»<br/>opção Ouvidoria"| acessarServicoExterno
    escolherCaminho --> contarPorTexto
    escolherCaminho -->|"«extend»"| contarPorAudio
    contarPorTexto --> selecionarIrregularidade
    contarPorAudio --> selecionarIrregularidade
    selecionarIrregularidade --> detalharOcorrencia
    detalharOcorrencia --> anexarEvidencia
    anexarEvidencia -->|"«extend»"| marcarGrupoVulneravel
    anexarEvidencia -->|"«extend»"| indicarTestemunha
    anexarEvidencia --> escolherAnonimato
    escolherAnonimato --> informarLocal
    informarLocal --> revisarDados
    revisarDados -->|"«include»"| enviarDenuncia
    enviarDenuncia --> mock
    enviarDenuncia --> receberProtocolo
    acessarServicoExterno --> mptExterno
    cidadao -.->|"a qualquer momento"| retomarAposF5
    cidadao -.->|"opcional"| instalarPwa

