        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n  %% Arquitetura lógica do Canal de Denúncias do MPT\n  %% Importação no draw.io: Organizar &gt; Inserir &gt; Avançado &gt; Mermaid\n\n  cidadao([Cidadã / Cidadão])\n\n  subgraph trust_browser[\&quot;Zona pública — navegador\&quot;]\n    direction TB\n    spa[\&quot;SPA Angular standalone&lt;br/&gt;wizard mobile-first e acessível\&quot;]\n    steps[\&quot;Acolhimento → Local → Ocorrências&lt;br/&gt;Irregularidades → Evidências → Identificação&lt;br/&gt;Revisão → Confirmação\&quot;]\n    state[\&quot;ComplaintService&lt;br/&gt;signals, estado e navegação\&quot;]\n    client[\&quot;ComplaintApiClient&lt;br/&gt;FormData + fetch\&quot;]\n    spa --&gt; steps --&gt; state --&gt; client\n  end\n\n  subgraph trust_edge[\&quot;Perímetro da aplicação\&quot;]\n    direction TB\n    ingress[\&quot;HTTPS / proxy reverso&lt;br/&gt;TLS, limites e headers\&quot;]\n    bff[\&quot;BFF Node.js + Express&lt;br/&gt;POST /api/denuncias\&quot;]\n    security[\&quot;Helmet + CORS allowlist&lt;br/&gt;rate limit + validação\&quot;]\n    upload[\&quot;Upload temporário controlado&lt;br/&gt;Multer em disco, tamanho e quantidade\&quot;]\n    controller[\&quot;Controller&lt;br/&gt;orquestra requisição e limpeza\&quot;]\n    domain[\&quot;ComplaintService (backend)&lt;br/&gt;validação + protocolo + payload\&quot;]\n    mptclient[\&quot;MPT API Client&lt;br/&gt;multipart, timeout e token server-side\&quot;]\n    docs[\&quot;Health + OpenAPI/Swagger&lt;br/&gt;docs restritas em produção\&quot;]\n    ingress --&gt; bff --&gt; security --&gt; upload --&gt; controller --&gt; domain --&gt; mptclient\n    bff -. monitoração .-&gt; docs\n  end\n\n\n  subgraph trust_private[\&quot;Zona privada de infraestrutura\&quot;]\n    direction TB\n    redis[(\&quot;Redis gerenciado&lt;br/&gt;contadores de rate limit com TTL\&quot;)]\n    clamav[\&quot;ClamAV daemon&lt;br/&gt;INSTREAM em rede privada\&quot;]\n    temp[(\&quot;Diretório temporário&lt;br/&gt;arquivos removidos após a requisição\&quot;)]\n    secrets[\&quot;Secret store / variáveis de ambiente&lt;br/&gt;MPT_API_TOKEN, URLs e credenciais\&quot;]\n    observability[\&quot;Logs e métricas sanitizados&lt;br/&gt;sem payload, PII, anexos ou tokens\&quot;]\n  end\n\n  subgraph trust_mpt[\&quot;Sistema externo confiável — MPT Digital\&quot;]\n    api[\&quot;API interna do MPT&lt;br/&gt;recepção e protocolo definitivo\&quot;]\n  end\n\n  cidadao --&gt;|\&quot;HTTPS\&quot;| spa\n  client --&gt;|\&quot;POST /api/denuncias&lt;br/&gt;multipart/form-data\&quot;| ingress\n  security &lt;--&gt;|\&quot;incremento / expiração\&quot;| redis\n  upload --&gt;|\&quot;grava com nome aleatório\&quot;| temp\n  temp --&gt;|\&quot;stream para varredura\&quot;| clamav\n  clamav --&gt;|\&quot;aprovado: prossegue&lt;br/&gt;ameaça: 422&lt;br/&gt;indisponível: 503\&quot;| controller\n  secrets -. \&quot;configuração em runtime\&quot; .-&gt; bff\n  secrets -. \&quot;Bearer somente no backend\&quot; .-&gt; mptclient\n  mptclient --&gt;|\&quot;HTTPS + multipart&lt;br/&gt;timeout e fail closed\&quot;| api\n  api --&gt;|\&quot;aceite + protocolo\&quot;| mptclient\n  bff -. \&quot;eventos técnicos\&quot; .-&gt; observability\n  controller --&gt;|\&quot;201 + protocolo&lt;br/&gt;ou erro explícito\&quot;| client\n\n  classDef actor fill:#E8F5E9,stroke:#16883E,color:#123D20,stroke-width:2px;\n  classDef frontend fill:#EEF0FF,stroke:#3F43CC,color:#171A66,stroke-width:2px;\n  classDef backend fill:#E8F2FF,stroke:#1463A5,color:#0A355A,stroke-width:2px;\n  classDef security fill:#FFF4E5,stroke:#E26A00,color:#713500,stroke-width:2px;\n  classDef infra fill:#F3F4F6,stroke:#59636E,color:#20262D,stroke-width:2px;\n  classDef external fill:#FFF0E8,stroke:#FF762E,color:#7A2D00,stroke-width:3px;\n  class cidadao actor;\n  class spa,steps,state,client frontend;\n  class ingress,bff,controller,domain,mptclient,docs backend;\n  class security,upload,clamav,secrets security;\n  class redis,temp,observability infra;\n  class api external;\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="u_Dtdyz6UOUgemxOru2l-1">
