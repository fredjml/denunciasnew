        web["«container»<br/><b>Aplicação web mobile-first</b><br/><i>Angular · TypeScript · standalone</i><br/>Wizard 8 telas com Progressive Disclosure<br/>WCAG 2.1 (ou 2.2 AA · DEC-DN-07)<br/>─────────────<br/>◆ provê: UI do denunciante<br/>◆ requer: /api/denuncias · IBGE"]
        bff["«container»<br/><b>API de entrada (BFF)</b><br/><i>Node.js · Express</i><br/>Segurança de borda, orquestração e<br/>coordenação dos novos serviços<br/>─────────────<br/>◆ provê: POST /api/denuncias · /health · /docs<br/>◆ requer: Redis · ClamAV · MPT · STT · Classificador · Alertas"]
        botAdapter["«container · NOVO · PART»<br/><b>WhatsApp Bot Adapter</b><br/><i>Node.js ou serviço externo</i><br/>Converte conversa em envelope<br/>compatível com o web<br/>(DN-RS-001 · DEC-DN-09)"]
